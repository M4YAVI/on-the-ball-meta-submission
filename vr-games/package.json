{
  "name": "vr-games-hub",
  "version": "1.0.0",
  "private": true,
  "description": "One lobby and seven games (Glove Up, Cricket Catch, Bulb Rush, ON THE BALL, ON THE BALL Football, ON THE BALL Tennis, ON THE BALL Baseball) on one HTTPS server",
  "scripts": {
    "start": "node one-server.mjs",
    "serve": "node one-server.mjs --serve",
    "dev": "node one-server.mjs",
    "test:lobby": "cd vr-lobby && npm run test:unit",
    "test:ontheball": "cd on-the-ball && npm test",
    "build:lobby": "cd vr-lobby && npm run build",
    "dev:multi": "node start-all.mjs"
  },
  "dependencies": {
    "@iwsdk/core": "1.1.0",
    "@pmndrs/uikit": "^1.0.74",
    "@pmndrs/uikit-horizon": "^1.0.74",
    "@pmndrs/uikit-lucide": "^1.0.74",
    "three": "npm:super-three@0.185.0"
  },
  "devDependencies": {
    "@iwsdk/cli": "1.1.0",
    "@iwsdk/reference": "1.1.0",
    "@iwsdk/vite-plugin-dev": "1.1.0",
    "vite": "^7.1.4"
  },
  "overrides": {
    "sharp": "0.35.4",
    "three": "npm:super-three@0.185.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}
