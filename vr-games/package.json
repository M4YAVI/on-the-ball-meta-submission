{
  "name": "vr-games-hub",
  "version": "1.0.0",
  "private": true,
  "description": "One lobby and four games (Glove Up, Cricket Catch, Bulb Rush, ON THE BALL) on one HTTPS server",
  "scripts": {
    "start": "node one-server.mjs",
    "serve": "node one-server.mjs --serve",
    "dev": "node one-server.mjs",
    "test:lobby": "cd vr-lobby && npm run test:unit",
    "test:ontheball": "cd ../on-the-ball && npm test",
    "build:lobby": "cd vr-lobby && npm run build",
    "dev:multi": "node start-all.mjs"
  }
}
