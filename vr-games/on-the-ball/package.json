{
  "name": "on-the-ball",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "iwsdk dev restart --open --foreground",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/**/*.test.mjs\" \"football/tests/**/*.test.mjs\" \"tennis/tests/**/*.test.mjs\" \"baseball/tests/**/*.test.mjs\"",
    "test:baseline": "node handoff-baseline/tests.mjs",
    "dev:football": "vite --config football/vite.config.js football",
    "build:football": "vite build --config football/vite.config.js football",
    "test:football": "node --test football/tests/football.test.mjs football/tests/goalkeeping.test.mjs",
    "dev:tennis": "vite --config tennis/vite.config.js tennis",
    "build:tennis": "vite build --config tennis/vite.config.js tennis",
    "test:tennis": "node --test tennis/tests/tennis.test.mjs",
    "dev:baseball": "vite --config baseball/vite.config.js baseball",
    "build:baseball": "vite build --config baseball/vite.config.js baseball",
    "test:baseball": "node --test baseball/tests/baseball.test.mjs baseball/tests/catching.test.mjs"
  },
  "dependencies": {
    "@iwsdk/core": "1.1.0",
    "@pmndrs/uikit": "^1.0.74",
    "@pmndrs/uikit-horizon": "^1.0.74",
    "@pmndrs/uikit-lucide": "^1.0.74",
    "three": "npm:super-three@0.185.0"
  },
  "devDependencies": {
    "@iwsdk/cli": "1.1.0",
    "@iwsdk/reference": "1.1.0",
    "@iwsdk/vite-plugin-dev": "1.1.0",
    "vite": "^7.1.4"
  },
  "overrides": {
    "sharp": "0.35.4",
    "three": "npm:super-three@0.185.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}
